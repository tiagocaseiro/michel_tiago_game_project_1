<Panel>
    <Id>battleMainPanel</Id>
    <VerticalAlignment>Stretch</VerticalAlignment>
    <HorizontalAlignment>Stretch</HorizontalAlignment> 
    <Children>
        <StackPanel>
            <Id>handPanel1</Id>
            <Orientation>Horizontal</Orientation>
            <Padding>20</Padding>
            <VerticalAlignment>Top</VerticalAlignment>
            <HorizontalAlignment>Center</HorizontalAlignment>
        </StackPanel>
        <StackPanel>
            <Id>flagsPanel</Id>
            <Orientation>Bottom</Orientation>
            <Padding>10</Padding>
            <VerticalAlignment>Center</VerticalAlignment>
            <HorizontalAlignment>Center</HorizontalAlignment> 
        </StackPanel>
        <StackPanel>
            <Id>handPanel2</Id>
            <Orientation>Horizontal</Orientation>
            <Padding>20</Padding>
            <VerticalAlignment>Bottom</VerticalAlignment>
            <HorizontalAlignment>Center</HorizontalAlignment> 
        </StackPanel>
        <Panel>
            <Id>troopsDrawPileParent</Id>
            <VerticalAlignment>Center</VerticalAlignment>
            <HorizontalAlignment>Left</HorizontalAlignment> 
            <Width>75</Width>
            <Height>100</Height>
            <MarginLeft>50</MarginLeft>
            <Children>
                <Template>
                    <Path>battle/templates/battle_card_template.xml</Path>
                </Template>
            </Children>
        </Panel>
        <Panel>
            <Id>tacticsDrawPileParent</Id>
            <VerticalAlignment>Center</VerticalAlignment>
            <HorizontalAlignment>Right</HorizontalAlignment> 
            <Width>75</Width>
            <Height>100</Height>
            <MarginRight>50</MarginRight>
            <Children>
                <Template>
                    <Path>battle/templates/battle_card_template.xml</Path>
                </Template>
            </Children>
        </Panel>
    </Children>
</Panel>
